# ---------------------------------------------------------------------------
# SmartAssist backend — environment template.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# CORS — comma-separated list of allowed origins (no trailing slash).
# Use * only in local development.
CORS_ORIGIN=*

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smartassist
DB_CONNECTION_LIMIT=10

# JWT — used later when authentication is added. Generate a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=1d
